# Keep lockfile generation enabled for deterministic dependency graphs.
package-lock=true

# Enforce Node engine requirements from package.json.
engine-strict=true

# Fail installs on peer dependency conflicts.
strict-peer-deps=true
legacy-peer-deps=false

# Avoid running third-party lifecycle scripts during install.
ignore-scripts=true

# Pin dependency versions when saving new packages.
save-exact=true

# Reduce noisy install output in CI and local runs.
fund=false
audit=false

# Keep TLS verification strict and use the public npm registry.
strict-ssl=true
registry=https://registry.npmjs.org/
